{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "portfolio/info-card",
  "version": "1.0.0",
  "title": "Info Card",
  "category": "design",
  "icon": "id-alt",
  "description": "A card with an image, heading, body text, and a CTA button.",
  "keywords": [ "card", "info", "cta" ],
  "textdomain": "info-card-block",
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/index.css",
  "style": "file:./build/style-style.css",
  "attributes": {
    "mediaId": {
      "type": "integer",
      "default": 0
    },
    "mediaUrl": {
      "type": "string",
      "default": ""
    },
    "mediaAlt": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": "Card Heading"
    },
    "bodyText": {
      "type": "string",
      "default": "Add a description for this card."
    },
    "buttonLabel": {
      "type": "string",
      "default": "Learn More"
    },
    "buttonUrl": {
      "type": "string",
      "default": "#"
    },
    "buttonColor": {
      "type": "string",
      "default": "#c0392b"
    }
  },
  "supports": {
    "html": false,
    "align": [ "wide", "full" ],
    "color": {
      "background": true,
      "text": true
    }
  }
}
